# 复制为 .env 后，自行填写两项本机密码；可以相同，但都不能为空；单引号可保留 $ 等字符。
# .env 由 Docker Compose 读取，不提交 Git，不发送给他人。
# MySQL root 管理员密码：用于数据库、账号和权限管理，仅传给 db 容器。
MYSQL_ROOT_PASSWORD=''
# campus_app 项目账号密码：供后端连接项目库，手动 mysql -u campus_app -p 查询时也输入此密码。
# Compose 将其同时传为 db 的 MYSQL_PASSWORD 和 backend 的 DB_PASSWORD。
DB_PASSWORD=''
# 已有 MySQL 数据卷时，修改此文件不会自动修改数据库账号密码。
